# HomeLens environment variables (placeholders only — never commit real secrets)
# Copy to .env and fill with real values. .env is gitignored.

# Supabase / Lovable Cloud (publishable anon key is safe to expose to the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_anon_key_here
VITE_SUPABASE_PROJECT_ID=your-project-id

# Sentry DSN (optional - for error monitoring in production)
# Get your DSN from https://sentry.io/
VITE_SENTRY_DSN=your_sentry_dsn_here
